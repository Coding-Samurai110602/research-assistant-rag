# ── Postgres / pgvector ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=research_assistant
POSTGRES_USER=ra_user
POSTGRES_PASSWORD=changeme

# ── Embedding model ───────────────────────────────────────────────────────────
# Options:
#   openai       → uses OPENAI_API_KEY below (text-embedding-3-small)
#   local        → uses BAAI/bge-small-en-v1.5 via sentence-transformers (no API cost)
EMBEDDING_PROVIDER=local

OPENAI_API_KEY=sk-...

# ── LLM (generation + grading nodes) ─────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6

ANTHROPIC_API_KEY=sk-ant-...

# ── arXiv ingestion ───────────────────────────────────────────────────────────
ARXIV_REQUEST_DELAY_SECONDS=3   # arXiv policy: ≥ 3s between requests

# ── RAG retrieval ────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6
MAX_QUERY_RETRIES=2

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8001
