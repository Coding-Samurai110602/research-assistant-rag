# Copy to .env (or .env.local) to point the frontend at a specific API backend.
# Vite only exposes vars prefixed VITE_, and inlines them at BUILD time — restart
# `npm run dev` / re-run `npm run build` after changing this file.

# Base URL of the FastAPI backend (no trailing slash). Unset → http://localhost:8000.
#   Local Docker:  VITE_API_BASE=http://localhost:8000
#   Deployed ALB:  get it via `terraform -chdir=infra/terraform output -raw api_url`
VITE_API_BASE=http://localhost:8000
